{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jfk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat จำเป็นเพราะ proxy.ts ของ Next 16 รันบน Node runtime เสมอ
  // global_fetch_strictly_public ทำให้ fetch ไปโดเมนตัวเองออกทางอินเทอร์เน็ตจริง ไม่วนกลับเข้า worker
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // โดเมนจริง ผูกไว้ในไฟล์นี้เพื่อให้ทุก deploy รักษาค่าเดิม
  // ไม่ใช่ค่าที่ตั้งไว้ในแดชบอร์ดแล้วหายไปกับความทรงจำ
  "routes": [
    { "pattern": "joodfangkhem.com", "custom_domain": true },
    { "pattern": "www.joodfangkhem.com", "custom_domain": true }
  ],
  "assets": {

    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jfk"
    }
  ],
  // ที่เก็บหน้า ISR ที่สร้างไว้แล้ว — ถ้าไม่มี binding นี้ หน้าแคชจะไม่ถูกเก็บข้ามคำขอ
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "jfk-cache"
    }
  ],
  // แคช ISR มีสองชั้นและคีย์ของทั้งคู่ขึ้นต้นด้วย buildId:
  //   R2        `<prefix>/<buildId>/<hash>.cache`
  //   Cache API `http://cache.local/<buildId>/<key>.cache`  (ของแต่ละดาต้าเซ็นเตอร์)
  // แต่ adapter **ไม่ได้ฝัง OPEN_NEXT_BUILD_ID ลงใน worker** ตอนรันจึงตกไปใช้ค่าสำรอง
  // "no-build-id" เหมือนกันทุก build ผลคือ **deploy ใหม่ไม่ล้างแคช** หน้าเก่าถูกเสิร์ฟต่อ
  // จนหมดอายุเอง (จุด 7 วัน / หน้ารวม 1 วัน) และชั้น Cache API ก็อายุเท่า revalidate ของหน้านั้น
  // ไม่ใช่ 30 นาที — purge จากแดชบอร์ดไม่ช่วย เพราะเป็น cache ที่ตั้งชื่อเองไม่ใช่ cache ของโซน
  //
  // ตั้งค่านี้เองเพื่อให้มี buildId จริง เวลาแก้ข้อมูลเป็นวงกว้างจนต้องสร้างทุกหน้าใหม่
  // (เช่นเปลี่ยนชื่อจีนหรือคำอ่านทั้ง 381 จุด) ให้ขยับเลขท้ายทีละหนึ่งแล้ว deploy
  // — คีย์เปลี่ยนทั้งสองชั้น ทุกหน้าจึงสร้างใหม่จาก Supabase
  //
  // อย่าผูกค่านี้กับ BUILD_ID ของ Next ให้เปลี่ยนเองทุก deploy เพราะจะต้องสร้าง 762 หน้าใหม่
  // ทุกครั้งและกิน CPU เกินโควตา (บทเรียนเดียวกับที่ทำให้ Vercel ล่ม)
  // แก้จุดเดี่ยว ๆ ใช้ revalidatePoint() ใน /admin ได้เหมือนเดิม
  //
  // ไอคอน (/icon.png, /apple-icon.png) ก็ติดกับดักนี้ด้วย เพราะ Next ทำเป็น app route
  // คำตอบเลยถูกเก็บในแคช ISR เหมือนหน้าเว็บ — เปลี่ยนไฟล์รูปแล้ว deploy เฉย ๆ ไม่พอ
  // ต้องขยับเลขนี้ด้วย (favicon.ico ไม่ติด เพราะเป็นไฟล์สแตติกใน .open-next/assets)
  // ของเก่าใน buildId ก่อนหน้าจะกลายเป็นขยะใน R2 ลบทิ้งทีหลังได้ผ่านแดชบอร์ด
  "vars": {
    "OPEN_NEXT_BUILD_ID": "jfk-3"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
